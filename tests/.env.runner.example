# URL of the SoccerBooking-test instance.
# IMPORTANT: use the host's LAN IP, not "localhost" — the test runner
# runs inside Docker and cannot reach the host via localhost.
# Find your IP with: hostname -I | awk '{print $1}'
APP_URL=http://192.168.x.x:8009

# Direct DB access for test setup/teardown — must point to the TEST database
DATABASE_URL=postgresql://user:password@<test-db-host>:5432/soccerbooking_test

# Must match the app's configured timezone
TIMEZONE=Europe/Paris
